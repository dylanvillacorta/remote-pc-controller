# ==========================================
# Configuración de Despliegue de Relay (.env)
# ==========================================

# Dirección en la que escucha el binario dentro del contenedor
LISTEN_ADDR=:8080

# Token secreto de autenticación (debe coincidir con la cabecera Authorization: Bearer <API_SECRET> enviada por Siri)
# Generar con: openssl rand -hex 32
API_SECRET=reemplazar-con-un-secreto-aleatorio-seguro

# Identificador único de la PC de destino
DEVICE_ID=sentinel-office

# URL del agente Sentinel en la PC Windows (ej. dirección IP LAN o hostname)
SENTINEL_URL=http://192.168.1.100:9876/v1/commands

# Vigencia del comando firmado en segundos (1-300)
VALIDITY_SECONDS=30

# Tamaño máximo del cuerpo de la petición en bytes (mínimo 1024)
MAX_BODY_BYTES=16384

# Clave privada RSA multilínea pasada directamente por el .env:
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEowIBAAKCAQEA0...
...
-----END RSA PRIVATE KEY-----"
