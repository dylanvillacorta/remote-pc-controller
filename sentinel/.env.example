# ==========================================
# Configuración del Agente Sentinel (.env)
# ==========================================

# Puerto de escucha del agente en la PC Windows (Requerido)
PORT=9876

# Identificador único de este dispositivo (debe coincidir con el DEVICE_ID del Relay)
DEVICE_ID=sentinel-office

# Clave pública RSA multilínea correspondiente a la clave privada del Relay (Requerido)
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
...
-----END PUBLIC KEY-----"

# Dirección de escucha (opcional, por defecto escucha en todas las interfaces en el puerto indicado)
# LISTEN_ADDR=0.0.0.0:9876

# Ruta al archivo para persistir el estado de los nonces y evitar ataques de repetición (opcional)
# STATE_PATH=replay-state.json

# Tolerancia máxima permitida para desajustes del reloj en segundos (opcional, por defecto 5)
CLOCK_SKEW_SECONDS=5

# Tamaño máximo permitido para el cuerpo de la petición en bytes (opcional, por defecto 65536)
MAX_BODY_BYTES=65536

# Certificados TLS para la comunicación HTTPS segura local con el Relay (opcional)
# TLS_CERT_FILE=c:\ruta\al\certificado.crt
# TLS_KEY_FILE=c:\ruta\al\certificado.key
