# ==========================================
# Configuración del Agente Sentinel (.env)
# ==========================================

# Puerto de escucha del agente en la PC Windows (Requerido)
PORT=9876

# Identificador único de este dispositivo (debe coincidir con el DEVICE_ID del Relay)
DEVICE_ID=sentinel-office

# Clave pública RSA en una sola línea (las líneas deben unirse con \n, sin comillas) (Requerido):
PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n...\n-----END PUBLIC KEY-----

# Tolerancia máxima permitida para desajustes del reloj en segundos (opcional, por defecto 5)
CLOCK_SKEW_SECONDS=5

# Tamaño máximo permitido para el cuerpo de la petición en bytes (opcional, por defecto 65536)
MAX_BODY_BYTES=65536
